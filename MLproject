name: no-show-prediction

python_env: python_env.yaml

entry_points:
  train:
    parameters:
      learning_rate: {type: float, default: 0.1}
      max_leaf_nodes: {type: int, default: 31}
    command: "python -m noshow.track --learning-rate {learning_rate} --max-leaf-nodes {max_leaf_nodes}"

  search:
    parameters:
      trials: {type: int, default: 8}
    command: "python -m noshow.track_search --trials {trials}"
